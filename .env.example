# OpenAI-compatible chat completions endpoint used by `--scorer llm`.
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Ollama:      http://localhost:11434/v1   (API key can be any non-empty string)
NST_LLM_BASE_URL=https://api.openai.com/v1
NST_LLM_API_KEY=sk-your-key-here
NST_LLM_MODEL=gpt-4o-mini
